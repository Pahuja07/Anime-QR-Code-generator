# Razorpay Dashboard API credentials. Keep real values out of source control.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Set true only for local development; never enable on a public service.
ANIQR_ALLOW_SIMULATED_PAYMENTS=false

# RunPod Serverless endpoint used by the FastAPI app.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Optional actual GPU hourly rate used to estimate each worker job's execution cost.
RUNPOD_GPU_HOURLY_RATE_USD=

# Comma-separated browser origins allowed to call the API (no trailing slash).
ANIQR_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500
